{
    "name": "skipify/vitex1",
    "version":"3.0.0",
    "description": "A Tiny Framework.轻量级的php resetful框架 for php8.2+.",
    "keywords": ["framework", "vitex","phpframework"],
    "license": "MIT",
    "homepage": "https://github.com/skipify/vitexframework",
    "support": {
        "issues": "https://github.com/skipify/vitexframework/issues",
        "source": "https://github.com/skipify/vitexframework"
    },
    "authors": [
        {
            "name": "skipify",
            "email": "skipify@qq.com"
        }
    ],
    "require": {
        "php": ">=8.2.0",
        "ext-openssl": "*",
        "ext-mbstring": "*",
        "php-di/php-di":"^7.0",
        "psr/log": "^3.0",
        "guzzlehttp/psr7": "^2.7",
        "monolog/monolog": "^3.0",
        "doctrine/cache": "^1.13",
        "psr/simple-cache": "^3.0",
        "ext-pdo": "*"
    },
    "autoload": {
        "psr-4": {"vitex\\": "vitex"}
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    }
}
